# Backend Environment Variables
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Neon.tech / PostgreSQL Connection String (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Security Configuration
JWT_SECRET_KEY=change_this_to_a_secure_32_byte_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini AI Studio API Key
GEMINI_API_KEY=AIzaSyYourGeneratedGeminiApiKeyHere
